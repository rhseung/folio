#!/usr/bin/env bash
#MISE description="Install origin/main (or a given ref) as the app and the CLI, built in a clean temporary worktree, and check both report its tag's version"
#USAGE arg "[ref]" help="The commit to install" default="origin/main"
set -euo pipefail

# 커밋한 FolioVersion은 자리표시값이므로, 그 커밋의 릴리스 태그 버전을 써넣은 뒤 빌드한다.
build_here() {
  mise run tectonic
  swift run -q folio-dev version stamp
  mise run install-mac
  mise run install-cli
}

# 임시 워크트리 안에서 이 작업을 다시 부를 때는 빌드만 한다.
if [ -n "${FOLIO_INSTALL_HERE:-}" ]; then
  build_here
  exit
fi

# 이 체크아웃이나 다른 세션의 워크트리에 있는, 커밋하지 않았거나 머지하지 않은 작업이 설치되지 않도록 임시 워크트리에서
# 빌드한다.
git fetch -q origin
sha=$(git rev-parse --verify "${usage_ref:-origin/main}^{commit}")
tmp=$(mktemp -d)
dir="$tmp/folio"
git worktree add -q --detach "$dir" "$sha"
trap 'git worktree remove --force "$dir"; rmdir "$tmp"' EXIT
cd "$dir"
mise trust -q
# 이 스크립트는 부른 체크아웃의 사본이라, 그 체크아웃이 오래됐으면 빌드 단계도 오래됐다(버전을 써넣기 전의 사본이 0.0.0을
# 설치했다). 그래서 설치할 커밋의 사본이 빌드한다. 그 사본에 위의 분기가 없으면 처음부터 다시 돌지 않도록 직접 빌드한다.
if grep -q FOLIO_INSTALL_HERE .mise/tasks/install-release; then
  FOLIO_INSTALL_HERE=1 mise run install-release
else
  build_here
fi

# 빌드 로그가 아니라 설치한 앱과 CLI에서 버전을 읽어, 태그의 버전과 다르면 실패한다.
want=$(swift run -q folio-dev version get)
app=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' /Applications/Folio.app/Contents/Info.plist)
build=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' /Applications/Folio.app/Contents/Info.plist)
cli=$(~/.local/bin/folio --version)
if [ "$app" != "$want" ] || [ "$cli" != "$want" ]; then
  echo "error: installed the app as $app and the CLI as $cli, not $want" >&2
  exit 1
fi
echo "installed $app ($build) from $(git rev-parse --short HEAD); folio --version $cli"
