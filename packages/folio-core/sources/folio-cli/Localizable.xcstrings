    "check.abstract": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GIST 폴더가 표준 구조를 따르는지 검사"
          }
        }
      }
    },
    "check.discussion": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표준 구조와 다른 곳이 있으면 목록을 보여 주고 종료 코드 4로 끝난다. 없으면 0이다.\n\n예시:\n  folio check\n  folio check --json"
          }
        }
      }
