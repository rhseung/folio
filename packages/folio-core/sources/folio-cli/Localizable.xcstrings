      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`folio catalog show --json`으로 받은 파일을 고쳐서 넣는다. 모르는 필드는 남는다.\n\n예시:\n  folio catalog set --file catalog.json --dry-run"
          }
        }
      }
    },
