    },
    "backup.restore.abstract": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 과목을 백업에서 새 폴더로 꺼낸다"
          }
        }
      }
    },
    "backup.restore.discussion": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "과목의 Notes, Ink, .folio를 백업 폴더 옆 restored 폴더에 새로 꺼낸다. GIST 폴더는 건드리지 않으니 비교해서 직접 옮긴다.\n\n예시:\n  folio backup restore EC4207 2026-10-27 --dry-run\n  folio backup restore EC4207 2026-10-27"
          }
        }
      }
    },
    "backup.restore.help.day": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업 날짜. 2026-10-27"
          }
        }
      }
    },
