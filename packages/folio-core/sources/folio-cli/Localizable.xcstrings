        }
      }
    },
    "requirement.check.abstract": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "졸업 요건에서 정할 것: 편람과 다른 분류, 이중 계산, 분류 없는 과목"
          }
