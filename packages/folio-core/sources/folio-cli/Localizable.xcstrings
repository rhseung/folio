    },
    "import.handbook.discussion": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 해 표는 바꾼다. 과목의 분류 제안을 보여 주며, 앱의 졸업 요건 화면에서 승인하거나 --accept로 바로 적용한다.\n\n예시:\n  folio import handbook ~/Downloads/handbook-2023.json --dry-run\n  folio import handbook ~/Downloads/handbook-2023.json --accept"
          }
        }
      }
    },
    "import.handbook.help.accept": {
      "extractionState": "manual",
      "localizations": {
