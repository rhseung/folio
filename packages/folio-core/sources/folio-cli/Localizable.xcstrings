    "assignment.set.abstract": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "과제의 제목, 마감, 상태, 성적 항목, 메모 바꾸기. 준 것만 바뀐다"
          }
        }
      }
    },
    "assignment.set.component-or-group": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "--component와 --group 중 하나만 주세요"
          }
        }
      }
    },
    "assignment.set.discussion": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "성적 항목이나 묶음을 바꾸면 이전 항목에 매긴 점수는 지워진다. 점수를 주면 상태는 graded가 된다.\n값을 지우려면 none을 준다.\n\n예시:\n  folio assignment set EC4207/HW3 --due \"2026-11-06 23:59\"\n  folio assignment set EC4207/HW3 --component 과제 --memo \"3번 질문함\"\n  folio assignment set EC4207/HW3 --component 과제 --score 9/10\n  folio assignment set EC4207/HW3 --due none --repeats weekly --dry-run"
          }
        }
      }
    },
    "assignment.set.group-not-found": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "성적 항목 묶음을 찾지 못했습니다: %@"
          }
        }
      }
    },
    "assignment.set.group-score-format": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "묶음이면 <항목>:9/10 꼴로 주세요"
          }
        }
      }
    },
    "assignment.set.help.assignment": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "<과목>/<과제>"
