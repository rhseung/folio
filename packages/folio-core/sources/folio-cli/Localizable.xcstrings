    "open.discussion": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "link와 같은 대상을 받아 그 folio:// 링크를 앱에서 연다. 앱이 꺼져 있으면 켠다. --dry-run이면 링크만 출력한다.\n\n예시:\n  folio open course EC4207 --dry-run\n  folio open exam EC4207/중간고사 --dry-run\n  folio open material EC4207/05_Matchings.pdf --page 12 --dry-run"
          }
        }
      }
