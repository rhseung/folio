    "backup.abstract": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜별 백업: 만들기, 목록, 과목 단위로 꺼내기"
          }
        }
      }
    },
    "backup.create.abstract": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 백업을 만든다"
          }
        }
      }
    },
    "backup.create.discussion": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GIST의 .folio와 각 과목의 Notes, Ink, .folio를 설정의 백업 폴더(기본 ~/Backups/Folio/auto)에 Folio-<날짜>.zip으로 묶는다.\n오늘 백업이 있으면 바꾼다. 보관 기간이 지난 백업은 지운다. GIST 폴더는 바뀌지 않는다.\n\n예시:\n  folio backup create --dry-run\n  folio backup create"
          }
        }
      }
    },
    "backup.list.abstract": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업 목록, 새것부터"
          }
        }
      }
    },
    "backup.list.discussion": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예시:\n  folio backup list\n  folio backup list --json"
          }
        }
      }
    },
    "backup.list.header.date": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜"
          }
        }
      }
    },
    "backup.list.header.file": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일"
          }
        }
