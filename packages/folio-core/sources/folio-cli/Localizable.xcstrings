{
  "sourceLanguage": "ko",
  "strings": {
    "actions.abstract": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 액션과 명령, 앱 화면, 동등성 테스트. --check로 커버리지 검사"
          }
        }
      }
    },
    "actions.cli-only": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령줄 전용"
          }
        }
      }
    },
    "actions.direct-write": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "액션 밖 변경: %@"
          }
        }
      }
    },
    "actions.discussion": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "--check는 명령이 없는 액션, 동등성 테스트가 없는 액션, 앱 코드에서 액션을 거치지 않고 파일을 바꾸는 곳이 있으면\n종료 코드 7로 끝난다. 액션 밖 쓰기가 맞는 곳(녹음, 대화, 공부 시간 기록)은 그 줄이나 바로 윗줄에\n`// folio:not-an-action <이유>`를 단다. 저장소 안에서 실행해야 한다.\n\n예시:\n  folio actions\n  folio actions --check --json\n  folio actions --schema"
          }
        }
      }
    },
    "actions.header.action": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "액션"
          }
        }
      }
    },
    "actions.header.command": {
