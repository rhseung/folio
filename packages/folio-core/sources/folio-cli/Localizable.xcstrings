    },
    "import.calendar.discussion": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "meetings.json은 CalendarMeeting 목록이다. 이미 있는 회차는 빈 시각과 주제만 채우고, 범위 안에서 수업이 없는 날의\n회차는 휴강으로 표시하며, 회차 이름의 복습 노트를 연결한다. lab 번호가 있는 수업은 그 실험의 단원(없으면\nLab<번호> <주제>로 만든다)에 연결한다.\n\n예시:\n  folio import calendar ~/Downloads/meetings.json --dry-run"
          }
        }
      }
    },
    "import.calendar.help.file": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CalendarMeeting 목록 JSON"
          }
        }
      }
    },
    "import.discussion": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져올 파일은 실제 학업 데이터라 저장소에 넣지 않는다. 먼저 --dry-run으로 계획을 보고, 확인한 뒤 실행한다."
          }
        }
      }
    },
    "import.exams.abstract": {
      "extractionState": "manual",
      "localizations": {
