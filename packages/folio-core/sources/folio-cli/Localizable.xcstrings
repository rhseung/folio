    "import.notes.abstract": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노션 강의 정리와 점수를 노트, 회차, 성적 항목으로"
          }
        }
      }
    },
    "import.notes.discussion": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덤프 폴더는 과목마다 <노션 페이지 ID>/index.json, notes/, assets/를 가진다. 노트 ID가 노션 페이지 ID라서 다시\n실행해도 중복되지 않고, 기존 항목에는 덧붙이기만 한다.\n\n예시:\n  folio import notes ~/Downloads/notion-dump --dry-run"
          }
        }
      }
    },
    "import.notes.help.folder": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덤프 폴더"
          }
        }
      }
    },
    "import.notion.abstract": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노션 학기, 강의, 성적을 transcript.json, catalog.json, course.json으로"
          }
        }
      }
    },
    "import.notion.discussion": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "export.json은 Notion MCP로 읽은 내용을 NotionExport 형식으로 담은 파일이다. transcript.json이나 catalog.json이\n이미 있으면 실행하지 않고(종료 코드 4), course.json이 있는 과목 폴더는 건너뛴다. 학기별 GPA를 노션 값과 비교한다.\n\n예시:\n  folio import notion ~/Downloads/export.json --dry-run"
          }
        }
      }
    },
    "import.requirements.abstract": {
      "extractionState": "manual",
      "localizations": {
